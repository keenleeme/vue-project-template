    @font-face {
      font-family: 'PrimaryFont';
      src: url('/assets/fonts/primary.woff2') format('woff2');
      font-display: swap; /* 快速显示后台字体 */
    }
  `;
  
  return { preloadFonts, fontDisplayStrategy };
};
