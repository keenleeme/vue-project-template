}, { deep: true })
```

## 枚举值管理最佳实践

### 1. 动态枚举值获取
使用统一的枚举值获取工具：
```typescript
import { getEnumOptions } from '@/api/common/getEnum'

// 在组件中加载枚举选项
const loadEnumData = async () => {
  industryOptions.value = await getEnumOptions('industry_type')
  statusOptions.value = await getEnumOptions('system_status')
  riskLevelOptions.value = await getEnumOptions('risk_level')
}

onMounted(() => {
  loadEnumData()
})
```

### 2. 静态常量定义
对于不经常变化的选项，可以定义为常量：
```typescript
// 定义常量选项
const STATIC_OPTIONS = {
  priority: [
    { label: '高', value: 'high' },
    { label: '中', value: 'middle' },
    { label: '低', value: 'low' }
  ],
  status: [
    { label: '启用', value: true },
    { label: '禁用', value: false }
  ]
}

// 或使用枚举
enum Priority {
  HIGH = 'high',
  MIDDLE = 'middle', 
  LOW = 'low'
}

const priorityOptions = [
  { label: '高', value: Priority.HIGH },
  { label: '中', value: Priority.MIDDLE },
  { label: '低', value: Priority.LOW }
]
```

### 3. 带缓存的枚举值管理
```typescript
// 带缓存的枚举值获取
const enumCache = new Map<string, any[]>()

const getCachedEnumOptions = async (groupCode: string, forceRefresh = false) => {
  if (!forceRefresh && enumCache.has(groupCode)) {
    return enumCache.get(groupCode)
  }
  
  const options = await getEnumOptions(groupCode)
  enumCache.set(groupCode, options)
  return options
}

// 清除缓存
const clearEnumCache = (groupCode?: string) => {
  if (groupCode) {
    enumCache.delete(groupCode)
  } else {
    enumCache.clear()
  }
}
```

### 4. 表单中的枚举值使用

#### 下拉框placeholder显示问题解决
```vue
<!-- 正确的下拉框使用方式 -->
<a-select
  v-model:value="searchForm.industry"
  placeholder="请选择所属行业"
  :options="industryOptions"
  allow-clear
/>
```

```typescript
// 对应的数据定义 - 关键是初始值的设置
const searchForm = reactive({
  industry: undefined, // ✅ 使用undefined以显示placeholder
  status: undefined,   // ✅ 使用undefined以显示placeholder
  name: '',           // ✅ 输入框可以使用空字符串
  tags: []            // ✅ 多选使用空数组
})

const industryOptions = ref([])

// ❌ 错误的重置方式 - 会导致placeholder消失
const handleResetWrong = () => {
  Object.assign(searchForm, {
    industry: '', // 空字符串会被认为是有效值，导致placeholder不显示
    status: ''
  })
}

// ✅ 正确的重置方式 - 保持placeholder显示
const handleReset = () => {
  Object.assign(searchForm, {
    industry: undefined, // 使用undefined恢复placeholder
    status: undefined,
    name: '',
    tags: []
  })
}
```

