  return {
    baseAPI: import.meta.env.VITE_APP_BASE_API,
    title: import.meta.env.VITE_APP_TITLE,
    version: import.meta.env.VITE_APP_VERSION,
    buildTime: import.meta.env.VITE_APP_BUILD_TIME
