    {
      name: '数据库类型',
      type: 'pie',
      radius: ['45%', '75%'],
      center: ['50%', '45%'],
      avoidLabelOverlap: false,
      itemStyle: {
        borderRadius: 6,
        borderColor: '#fff',
        borderWidth: 1
      },
      label: {
        show: true,
        overflow: 'truncate',
