#### 3.1 饼图超长文本处理

饼图图例文字超长时需要截断处理：

```typescript
// 处理饼图数据，截断超长文本
const processPieChartData = (data: any[]) => {
  return data.map(item => ({
    ...item,
    name: item.name.length > 8 ? item.name.substring(0, 8) + '...' : item.name
  }));
};

// 饼图配置
const pieChartOption = ref({
  tooltip: {
    trigger: 'item',
    formatter: '{a} <br/>{b}: {c} ({d}%)'
  },
  legend: {
    orient: 'horizontal',
    bottom: 0,
    left: 'center',
    itemWidth: 12,
    itemHeight: 8,
    textStyle: {
      fontSize: 12,
      overflow: 'truncate',
      ellipsis: '...',
      width: 100
    }
  },
  series: [
    {
      name: '数据库类型',
      type: 'pie',
      radius: ['45%', '75%'],
      center: ['50%', '45%'],
      avoidLabelOverlap: false,
      itemStyle: {
        borderRadius: 6,
        borderColor: '#fff',
        borderWidth: 1
      },
      label: {
        show: true,
        overflow: 'truncate',
        ellipsis: '...',
        width: 100
      },
      labelLine: {
        show: true
      },
      data: [] as PieChartDataItem[]
    }
  ]
});

// 更新饼图数据时处理超长文本
const updatePieChartData = (data: any[]) => {
  pieChartOption.value.series[0].data = data.map(item => ({
    name: item.name.length > 8 ? item.name.substring(0, 8) + '...' : item.name,
    value: item.value,
    // 保存原始名称用于 tooltip 显示
    originalName: item.name
  }));
};

// 自定义 tooltip 显示完整文本
const pieChartOptionWithCustomTooltip = ref({
  tooltip: {
    trigger: 'item',
    formatter: (params: any) => {
      // 使用原始名称显示完整文本
      const originalName = params.data.originalName || params.name;
