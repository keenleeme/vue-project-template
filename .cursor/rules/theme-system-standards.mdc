## 主题 Store 使用

### 1. Store 定义
```typescript
// src/store/uedModule/theme/index.ts
import { defineStore } from 'pinia';

export default defineStore('theme', () => {
  // 主题配置
  const themeConfig = ref<ThemeConfigType>({ 
    ...themeDefaultConfig, 
    ...localThemeConfig 
  });

  // 设置主题配置
  const setThemeConfig = (config: ThemeConfigType) => {
    themeConfig.value = { ...themeDefaultConfig, ...config };
  };

  // 重置主题色
  const resetThemePrimaryColor = () => {
    themeConfig.value.primaryColor = themeDefaultConfig.primaryColor;
  };

  // 重置所有配置
  const reset = () => {
    themeConfig.value = { ...themeDefaultConfig };
  };

  // 计算主题
  const theme = computed(() => {
    const token = themeTokens[themeConfig.value.mode];
    const { primaryColors, darkPrimaryColors } = getPrimaryColors();
    
    return {
      token: {
        ...token,
        colorPrimary: themeConfig.value.mode === 'dark' 
          ? primaryColors[4] 
          : primaryColors[5]
      },
      algorithm: themeConfig.value.mode === 'dark' 
        ? darkAlgorithm 
        : defaultAlgorithm
    };
  });

  return {
    themeConfig,
    setThemeConfig,
    resetThemePrimaryColor,
    reset,
    theme
  };
});
```

### 2. Store 使用
```vue
<template>
  <a-config-provider :theme="theme">
    <!-- 应用内容 -->
  </a-config-provider>
</template>

<script setup lang="ts">
import { storeToRefs } from 'pinia';
import { useThemeStore } from '@/store';

const themeStore = useThemeStore();
const { theme, themeConfig } = storeToRefs(themeStore);

// 切换主题模式
const toggleTheme = () => {
  themeStore.setThemeConfig({
    ...themeConfig.value,
    mode: themeConfig.value.mode === 'light' ? 'dark' : 'light'
  });
};

// 更改主题色
const changePrimaryColor = (color: string) => {
  themeStore.setThemeConfig({
    ...themeConfig.value,
    primaryColor: color
  });
};
</script>
```

