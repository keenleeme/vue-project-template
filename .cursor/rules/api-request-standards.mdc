## 5. 文件上传处理规范

### 5.1 文件上传

```typescript
// 文件上传
const uploadFile = async (file: File) => {
  const formData = new FormData();
  formData.append('file', file);
  formData.append('type', 'document'); // 文件类型标识
  
  try {
    const res = await Http.post('/api/upload', formData, {
      headers: {
        'Content-Type': 'multipart/form-data'
      }
    });
    
    if (res.code === 0) {
      return res.data;
    }
    throw new Error(res.message || '文件上传失败');
  } catch (error) {
    console.error('文件上传失败:', error);
    throw error;
  }
};
```

## 6. 导入导出处理规范

### 6.1 数据导入

```typescript
// Excel 数据导入
const importData = async (file: File) => {
  const formData = new FormData();
  formData.append('file', file);
  
  try {
    const res = await Http.post('/api/database-accounts/import', formData, {
      headers: {
        'Content-Type': 'multipart/form-data'
      }
    });
    
    if (res.code === 0) {
      message.success(`导入成功，共导入 ${res.data.successCount} 条数据`);
      if (res.data.failCount > 0) {
        message.warning(`${res.data.failCount} 条数据导入失败`);
      }
      return res.data;
    }
    throw new Error(res.message || '导入失败');
  } catch (error) {
    message.error('导入失败，请检查文件格式');
    throw error;
  }
};
```

### 6.2 数据导出

```typescript
// 数据导出
const exportData = async (params: any) => {
  try {
    const res = await Http.post('/api/database-accounts/export', params, {
      responseType: 'blob'
    });
    
    // 创建下载链接
    const url = window.URL.createObjectURL(new Blob([res]));
    const link = document.createElement('a');
    link.href = url;
    link.download = `数据库账号列表_${new Date().getTime()}.xlsx`;
    link.click();
    
    // 清理资源
    window.URL.revokeObjectURL(url);
    
    message.success('导出成功');
  } catch (error) {
    console.error('导出失败:', error);
    message.error('导出失败，请稍后重试');
  }
};
```

## 7. API 接口设计规范

### 7.1 RESTful API 规范

```typescript
// 标准的 CRUD 接口设计
interface DatabaseAccountApi {
  // 查询列表
  getList: (params: ListParams) => Promise<ApiResponse<ListData>>;
  
  // 获取详情
  getDetail: (id: string) => Promise<ApiResponse<DetailData>>;
  
  // 新增
  create: (data: CreateData) => Promise<ApiResponse<any>>;
  
  // 更新
  update: (id: string, data: UpdateData) => Promise<ApiResponse<any>>;
  
  // 删除
  delete: (id: string) => Promise<ApiResponse<any>>;
  
  // 批量操作
  batchDelete: (ids: string[]) => Promise<ApiResponse<any>>;
  
  // 状态操作
  enable: (id: string) => Promise<ApiResponse<any>>;
  disable: (id: string) => Promise<ApiResponse<any>>;
}
```

### 7.2 接口命名规范

```typescript
// API 文件组织规范
// src/api/databaseAccount.ts
export const databaseAccountApi = {
  getList: (params: any) => Http.get('/api/database-accounts', { params }),
  getDetail: (id: string) => Http.get(`/api/database-accounts/${id}`),
  create: (data: any) => Http.post('/api/database-accounts', data),
  update: (id: string, data: any) => Http.put(`/api/database-accounts/${id}`, data),
  delete: (id: string) => Http.delete(`/api/database-accounts/${id}`),
  batchDelete: (ids: string[]) => Http.post('/api/database-accounts/batch-delete', { ids }),
  import: (file: File) => {
    const formData = new FormData();
    formData.append('file', file);
    return Http.post('/api/database-accounts/import', formData);
  },
  export: (params: any) => Http.post('/api/database-accounts/export', params, { responseType: 'blob' })
};
```

## 8. 性能优化建议

### 8.1 请求优化

```typescript
// 使用 AbortController 取消请求
const abortController = new AbortController();

const searchData = async (keyword: string) => {
  try {
    const res = await Http.get('/api/search', {
      params: { keyword },
      signal: abortController.signal
    });
    return res.data;
  } catch (error) {
    if (error.name === 'AbortError') {
      console.log('请求已取消');
    } else {
      throw error;
    }
  }
};

// 组件卸载时取消请求
onUnmounted(() => {
  abortController.abort();
});
```

### 8.2 缓存策略

```typescript
// 简单的内存缓存
const cache = new Map();
const CACHE_EXPIRE_TIME = 5 * 60 * 1000; // 5分钟

const getCachedData = async (key: string, fetcher: () => Promise<any>) => {
  const cached = cache.get(key);
  
  if (cached && Date.now() - cached.timestamp < CACHE_EXPIRE_TIME) {
    return cached.data;
  }
  
  const data = await fetcher();
  cache.set(key, {
    data,
    timestamp: Date.now()
  });
  
  return data;
};

// 使用示例
const getEnumOptionsWithCache = (enumType: string) => {
  return getCachedData(`enum_${enumType}`, () => getEnumOptions(enumType));
};
```

## 9. 最佳实践总结

### 9.1 开发规范

1. **统一使用 Http 客户端**，禁止直接使用其他 HTTP 库
2. **所有 API 调用必须进行错误处理**
3. **使用 TypeScript 定义接口类型**
4. **遵循 RESTful API 设计规范**
5. **合理使用缓存策略**

### 9.2 错误处理

1. **使用 try-catch 包装所有异步操作**
2. **提供用户友好的错误提示**
3. **记录详细的错误日志**
4. **处理网络异常和超时**

### 9.3 性能优化

1. **避免重复请求**
2. **使用适当的缓存策略**
3. **支持请求取消**
4. **优化大数据量处理**

### 9.4 代码质量

1. **使用 TypeScript 类型定义**
2. **编写清晰的 JSDoc 注释**
3. **遵循统一的命名规范**
4. **保持代码的可读性和可维护性**
