### 2.3 工具函数测试

```typescript
// src/utils/format.test.ts
import { describe, it, expect } from 'vitest';
import { formatCurrency, formatDate, truncateText } from './format';

describe('格式化工具函数', () => {
  describe('formatCurrency', () => {
    it('应该正确格式化货币', () => {
      expect(formatCurrency(1234.56)).toBe('¥1,234.56');
      expect(formatCurrency(0)).toBe('¥0.00');
      expect(formatCurrency(-100)).toBe('-¥100.00');
    });

    it('应该处理无效输入', () => {
      expect(formatCurrency(null)).toBe('¥0.00');
      expect(formatCurrency(undefined)).toBe('¥0.00');
      expect(formatCurrency(NaN)).toBe('¥0.00');
    });
  });

  describe('formatDate', () => {
    it('应该正确格式化日期', () => {
      const date = new Date('2023-12-25T10:30:00');
      expect(formatDate(date, 'YYYY-MM-DD')).toBe('2023-12-25');
      expect(formatDate(date, 'YYYY年MM月DD日')).toBe('2023年12月25日');
    });

    it('应该处理时间戳', () => {
      const timestamp = 1703505000000;
      expect(formatDate(timestamp, 'YYYY-MM-DD')).toBe('2023-12-25');
    });

    it('应该处理无效日期', () => {
      expect(formatDate(null)).toBe('');
      expect(formatDate('invalid')).toBe('');
    });
  });

  describe('truncateText', () => {
    it('应该正确截断文本', () => {
      const longText = '这是一段很长的文本内容';
      expect(truncateText(longText, 5)).toBe('这是一段很...');
      expect(truncateText(longText, 20)).toBe(longText);
    });

    it('应该处理边界情况', () => {
      expect(truncateText('', 10)).toBe('');
      expect(truncateText('短文本', 10)).toBe('短文本');
      expect(truncateText(null, 10)).toBe('');
    });
  });
});
```

### 2.4 Store 测试

```typescript
// src/store/user.test.ts
import { describe, it, expect, beforeEach } from 'vitest';
import { setActivePinia, createPinia } from 'pinia';
import { useUserStore } from './user';

describe('User Store', () => {
  beforeEach(() => {
    // 为每个测试创建新的 Pinia 实例
    setActivePinia(createPinia());
  });

  describe('状态管理', () => {
    it('应该正确设置用户信息', () => {
      const userStore = useUserStore();
      const mockUser = {
        id: '1',
        name: '测试用户',
        email: 'test@example.com',
        roles: ['user']
      };

      userStore.setUserInfo(mockUser);

      expect(userStore.userInfo).toEqual(mockUser);
      expect(userStore.isLoggedIn).toBe(true);
    });

    it('应该正确设置权限', () => {
      const userStore = useUserStore();
      const permissions = ['read', 'write', 'delete'];

      userStore.setPermissions(permissions);

      expect(userStore.permissions).toEqual(permissions);
    });

    it('应该正确执行登出', () => {
      const userStore = useUserStore();
      
      // 先设置用户信息
      userStore.setUserInfo({ id: '1', name: 'Test', roles: [] });
      userStore.setPermissions(['read']);

      // 执行登出
      userStore.logout();

      expect(userStore.userInfo).toBeNull();
      expect(userStore.permissions).toEqual([]);
      expect(userStore.isLoggedIn).toBe(false);
    });
  });

  describe('权限检查', () => {
    it('应该正确检查权限', () => {
      const userStore = useUserStore();
      userStore.setPermissions(['read', 'write']);

      expect(userStore.hasPermission('read')).toBe(true);
      expect(userStore.hasPermission('write')).toBe(true);
      expect(userStore.hasPermission('delete')).toBe(false);
    });

    it('应该正确检查管理员权限', () => {
      const userStore = useUserStore();
      
      userStore.setUserInfo({ 
        id: '1', 
        name: 'Admin', 
        roles: ['admin'] 
      });
      expect(userStore.isAdmin).toBe(true);

      userStore.setUserInfo({ 
        id: '2', 
        name: 'User', 
        roles: ['user'] 
      });
      expect(userStore.isAdmin).toBe(false);
    });
  });
});
```

### 2.5 Composable 测试

```typescript
// src/composables/useAuth.test.ts
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { setActivePinia, createPinia } from 'pinia';
import { useAuth } from './useAuth';
import * as authApi from '@/api/auth';

// Mock API
vi.mock('@/api/auth', () => ({
  login: vi.fn(),
  logout: vi.fn()
}));

describe('useAuth Composable', () => {
  beforeEach(() => {
    setActivePinia(createPinia());
    vi.clearAllMocks();
  });

  describe('登录功能', () => {
    it('应该成功登录', async () => {
      const mockResponse = {
        userInfo: { id: '1', name: 'Test User', roles: ['user'] },
        permissions: ['read', 'write'],
        token: 'mock-token'
      };

      vi.mocked(authApi.login).mockResolvedValue(mockResponse);

      const { login, isAuthenticated } = useAuth();
      const result = await login({
        username: 'test',
        password: 'password'
      });

      expect(authApi.login).toHaveBeenCalledWith({
        username: 'test',
        password: 'password'
      });
      expect(result).toEqual(mockResponse);
      expect(isAuthenticated.value).toBe(true);
    });

    it('应该处理登录失败', async () => {
      const mockError = new Error('登录失败');
      vi.mocked(authApi.login).mockRejectedValue(mockError);

      const { login } = useAuth();

      await expect(login({
        username: 'test',
        password: 'wrong'
      })).rejects.toThrow('登录失败');
    });
  });

  describe('登出功能', () => {
    it('应该成功登出', async () => {
      vi.mocked(authApi.logout).mockResolvedValue(undefined);

      const { logout, isAuthenticated } = useAuth();
      
      // 先登录
      const userStore = useUserStore();
      userStore.setUserInfo({ id: '1', name: 'Test', roles: [] });

      // 执行登出
      await logout();

      expect(authApi.logout).toHaveBeenCalled();
      expect(isAuthenticated.value).toBe(false);
    });

    it('应该处理登出API失败但仍清理本地状态', async () => {
      vi.mocked(authApi.logout).mockRejectedValue(new Error('网络错误'));

      const { logout, isAuthenticated } = useAuth();
      
      // 先登录
      const userStore = useUserStore();
      userStore.setUserInfo({ id: '1', name: 'Test', roles: [] });

      // 执行登出（不应该抛出错误）
      await logout();

      expect(isAuthenticated.value).toBe(false);
    });
  });
});
```

## 3. 组件测试规范

### 3.1 Vue 组件测试

```typescript
// src/components/UserCard.test.ts
import { describe, it, expect, vi } from 'vitest';
import { mount } from '@vue/test-utils';
import { createPinia } from 'pinia';
import UserCard from './UserCard.vue';

// Mock Ant Design Vue 组件
vi.mock('ant-design-vue', () => ({
  message: {
    success: vi.fn(),
    error: vi.fn()
  }
}));

describe('UserCard 组件', () => {
  const createWrapper = (props = {}) => {
    return mount(UserCard, {
      props: {
        user: {
          id: '1',
          name: '测试用户',
          email: 'test@example.com',
          avatar: 'https://example.com/avatar.jpg',
          status: 'active'
        },
        ...props
      },
      global: {
        plugins: [createPinia()]
      }
    });
  };

  describe('渲染测试', () => {
    it('应该正确渲染用户信息', () => {
      const wrapper = createWrapper();

      expect(wrapper.find('.user-name').text()).toBe('测试用户');
      expect(wrapper.find('.user-email').text()).toBe('test@example.com');
      expect(wrapper.find('.user-avatar').attributes('src')).toBe('https://example.com/avatar.jpg');
    });

    it('应该根据状态显示不同的标签', () => {
      const activeWrapper = createWrapper({
        user: { id: '1', name: 'Test', status: 'active' }
      });
      expect(activeWrapper.find('.status-tag').classes()).toContain('status-active');

      const inactiveWrapper = createWrapper({
        user: { id: '1', name: 'Test', status: 'inactive' }
      });
      expect(inactiveWrapper.find('.status-tag').classes()).toContain('status-inactive');
    });

    it('应该处理缺失的头像', () => {
      const wrapper = createWrapper({
        user: { id: '1', name: 'Test', avatar: null }
      });

      expect(wrapper.find('.user-avatar').attributes('src')).toBe('/default-avatar.png');
    });
  });

  describe('交互测试', () => {
    it('应该在点击编辑按钮时触发事件', async () => {
      const wrapper = createWrapper();
      const editButton = wrapper.find('[data-testid="edit-button"]');

      await editButton.trigger('click');

      expect(wrapper.emitted('edit')).toBeTruthy();
      expect(wrapper.emitted('edit')?.[0]).toEqual([{ id: '1', name: '测试用户' }]);
    });

    it('应该在点击删除按钮时显示确认框', async () => {
      const wrapper = createWrapper();
      const deleteButton = wrapper.find('[data-testid="delete-button"]');

      await deleteButton.trigger('click');

      expect(wrapper.find('.delete-confirm').exists()).toBe(true);
    });

    it('应该在确认删除时触发删除事件', async () => {
      const wrapper = createWrapper();
      
      // 点击删除按钮
      await wrapper.find('[data-testid="delete-button"]').trigger('click');
      
      // 确认删除
      await wrapper.find('[data-testid="confirm-delete"]').trigger('click');

      expect(wrapper.emitted('delete')).toBeTruthy();
      expect(wrapper.emitted('delete')?.[0]).toEqual([{ id: '1' }]);
    });
  });

  describe('权限测试', () => {
    it('应该根据权限显示或隐藏操作按钮', () => {
      const wrapperWithPermission = createWrapper({
        hasEditPermission: true,
        hasDeletePermission: true
      });
      expect(wrapperWithPermission.find('[data-testid="edit-button"]').exists()).toBe(true);
      expect(wrapperWithPermission.find('[data-testid="delete-button"]').exists()).toBe(true);

      const wrapperWithoutPermission = createWrapper({
        hasEditPermission: false,
        hasDeletePermission: false
      });
      expect(wrapperWithoutPermission.find('[data-testid="edit-button"]').exists()).toBe(false);
      expect(wrapperWithoutPermission.find('[data-testid="delete-button"]').exists()).toBe(false);
    });
  });
});
```

### 3.2 DAS 组件测试

```typescript
// src/components/DataTable.test.ts
import { describe, it, expect, vi } from 'vitest';
import { mount } from '@vue/test-utils';
import DataTable from './DataTable.vue';

// Mock DAS 组件
vi.mock('das-component-vue', () => ({
  DasTable: {
    name: 'DasTable',
    template: '<div class="das-table"><slot /></div>',
    props: ['columns', 'dataSource', 'pagination', 'loading']
  }
}));

describe('DataTable 组件', () => {
  const mockColumns = [
    { title: '姓名', dataIndex: 'name', key: 'name' },
    { title: '邮箱', dataIndex: 'email', key: 'email' },
    { title: '操作', dataIndex: 'action', key: 'action' }
  ];

  const mockData = [
    { id: '1', name: '张三', email: 'zhangsan@example.com' },
    { id: '2', name: '李四', email: 'lisi@example.com' }
  ];

  const createWrapper = (props = {}) => {
    return mount(DataTable, {
      props: {
        columns: mockColumns,
        dataSource: mockData,
        loading: false,
        ...props
      }
    });
  };

  describe('基础功能', () => {
    it('应该正确传递 props 到 DAS 表格', () => {
      const wrapper = createWrapper({
        loading: true,
        pagination: { current: 1, pageSize: 10, total: 100 }
      });

      const dasTable = wrapper.findComponent({ name: 'DasTable' });
      expect(dasTable.props('columns')).toEqual(mockColumns);
      expect(dasTable.props('dataSource')).toEqual(mockData);
      expect(dasTable.props('loading')).toBe(true);
      expect(dasTable.props('pagination')).toEqual({
        current: 1,
        pageSize: 10,
        total: 100
      });
    });

    it('应该处理表格变化事件', async () => {
      const wrapper = createWrapper();
      const dasTable = wrapper.findComponent({ name: 'DasTable' });

      const paginationChange = {
        current: 2,
        pageSize: 20,
        total: 100
      };

      await dasTable.vm.$emit('change', paginationChange, {}, {});

      expect(wrapper.emitted('tableChange')).toBeTruthy();
      expect(wrapper.emitted('tableChange')?.[0]).toEqual([paginationChange]);
    });
  });

  describe('数据处理', () => {
    it('应该正确处理空数据', () => {
      const wrapper = createWrapper({
        dataSource: []
      });

      const dasTable = wrapper.findComponent({ name: 'DasTable' });
      expect(dasTable.props('dataSource')).toEqual([]);
    });

    it('应该正确处理加载状态', () => {
      const wrapper = createWrapper({
        loading: true
      });

      const dasTable = wrapper.findComponent({ name: 'DasTable' });
      expect(dasTable.props('loading')).toBe(true);
    });
  });
});
```

