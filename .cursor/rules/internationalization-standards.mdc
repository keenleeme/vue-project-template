## 在组件中使用

### 1. 基础使用
```vue
<template>
  <div>
    <!-- 直接使用翻译 -->
    <h1>{{ $t('I18N.common.userManage') }}</h1>
    
    <!-- 按钮文字 -->
    <a-button type="primary">
      {{ $t('I18N.common.add') }}
    </a-button>
    
    <!-- 表格列标题 -->
    <a-table :columns="columns" :dataSource="data" />
  </div>
</template>

<script setup lang="ts">
import { useI18n } from 'vue-i18n';

const { t } = useI18n();

// 定义表格列
const columns = [
  {
    title: t('I18N.common.username'),
    dataIndex: 'username',
    key: 'username'
  },
  {
    title: t('I18N.common.status'),
    dataIndex: 'status',
    key: 'status'
  }
];
</script>
```

### 2. 动态翻译
```vue
<script setup lang="ts">
import { computed } from 'vue';
import { useI18n } from 'vue-i18n';

const { t, locale } = useI18n();

// 计算属性中使用翻译
const statusOptions = computed(() => [
  { label: t('I18N.common.enable'), value: 1 },
  { label: t('I18N.common.disable'), value: 0 }
]);

// 方法中使用翻译
const showMessage = (type: 'success' | 'error') => {
  const message = type === 'success' 
    ? t('I18N.common.operateSuccess')
    : t('I18N.common.operateFailed');
  
  console.log(message);
};
</script>
```

