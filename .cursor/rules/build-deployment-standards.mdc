### 2.2 环境配置工具

```typescript
// configs/utils.ts
import path from 'path';
import dotenv from 'dotenv';
import fs from 'fs';

function getPath(_path: string) {
  return path.join(process.cwd(), _path);
}

function packageInfo() {
  const buf = fs.readFileSync(getPath('package.json'));
  return JSON.parse(buf.toString());
}

function loadEnv() {
  const mode = process.env.NODE_ENV || 'development';
  const env = dotenv.config({
    path: getPath(`.env.${mode}`)
  });
  
  if (env.error) {
    console.error(`环境配置文件 .env.${mode} 加载失败:`, env.error);
    return {};
  }
  
  // 添加构建时间
  const envParsed = env.parsed || {};
  envParsed.VITE_APP_BUILD_TIME = new Date().toISOString();
  
  return envParsed;
}

export { getPath, packageInfo, loadEnv };
```

