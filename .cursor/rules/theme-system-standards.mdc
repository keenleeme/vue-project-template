## 主题色算法

### 1. 颜色生成
```typescript
// src/store/uedModule/theme/index.ts
import { generate } from '@ant-design/colors';
import Color from 'color';

function getPrimaryColors() {
  const color = Color(themeConfig.value.primaryColor);
  
  // 暗色主题的主色调整
  const darkOriginColor = color
    .saturate(15 / 85)
    .lighten(0.3)
    .hex();
    
  const primaryColors = generate(themeConfig.value.primaryColor);
  const darkPrimaryColors = generate(darkOriginColor, { 
    theme: 'dark', 
    backgroundColor: '#1c222e' 
  });
  
  return { primaryColors, darkPrimaryColors };
}
```

### 2. 动态主题色应用
```typescript
// src/theme/themeAlgorithm.ts
const applyThemeColors = () => {
  const { primaryColors, darkPrimaryColors } = getPrimaryColors();
  const bodyEl = document.body;
  
  // 设置CSS变量
  bodyEl.style.setProperty('--um-primary-color-normal', primaryColors[5]);
  bodyEl.style.setProperty('--um-primary-color-hover', primaryColors[4]);
  bodyEl.style.setProperty('--um-dark-primary-color-normal', darkPrimaryColors[5]);
  bodyEl.style.setProperty('--um-dark-primary-color-hover', darkPrimaryColors[4]);
};
```

## Ant Design 主题集成

### 1. 基础主题配置
```typescript
// src/theme/theme.ts
const theme = {
  token: {
    colorPrimary: '#134bea',
    colorPrimaryHover: '#3B71EE',
    colorPrimaryActive: '#0639C3',
    colorError: '#F53C3C',
    colorSuccess: '#1DB969',
    colorWarning: '#FF7F29',
    borderRadius: 3
  },
  components: {
    Button: {
      colorBorder: '#CBD0DB',
      colorLink: '#134BEA',
      colorBgTextHover: '#F6F7FB'
    },
    Table: {
      colorTextHeading: 'var(--color-text-primarys)',
      colorBgContainer: 'var(--color-bg-container)'
    }
  }
};
```

### 2. 动态主题算法
```typescript
// 在Store中计算动态主题
const theme = computed(() => {
  const token = themeTokens[themeConfig.value.mode];
  const { primaryColors, darkPrimaryColors } = getPrimaryColors();
  const isDark = themeConfig.value.mode === 'dark';
  
  return {
    token: {
      ...token,
      colorPrimary: isDark ? primaryColors[4] : primaryColors[5],
      colorPrimaryHover: isDark ? darkPrimaryColors[4] : primaryColors[4]
    },
    algorithm: isDark ? darkAlgorithm : defaultAlgorithm,
    components: {
      Button: {
        colorLink: isDark ? darkPrimaryColors[5] : primaryColors[5]
      },
      Select: {
        controlItemBgActive: isDark ? darkPrimaryColors[0] : primaryColors[0]
      }
    }
  };
});
```

