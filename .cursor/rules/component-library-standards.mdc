      v-model:value="searchForm.status"
      :options="statusOptions"
      placeholder="请选择状态"
      allow-clear
    />
  </a-form-item>
</das-search-bar>

<!-- DAS 表单 - 新增/编辑表单 -->
<das-form
  ref="formRef"
  :model="formData"
  :rules="rules"
  :label-col="{ span: 6 }"
  :wrapper-col="{ span: 18 }"
  layout="horizontal"
>
  <a-form-item label="名称" name="name" :rules="rules.name">
    <a-input v-model:value="formData.name" placeholder="请输入名称" />
  </a-form-item>
  
  <a-form-item label="类型" name="type" :rules="rules.type">
    <das-select
      v-model:value="formData.type"
      :options="typeOptions"
      placeholder="请选择类型"
    />
  </a-form-item>
  
  <a-form-item label="标签" name="tags">
    <das-select
      v-model:value="formData.tags"
      :options="tagOptions"
      placeholder="请选择标签"
      mode="multiple"
    />
  </a-form-item>
</das-form>
```

