### 4.2 常用测试工具函数

```typescript
// tests/utils/test-utils.ts
import { mount, VueWrapper } from '@vue/test-utils';
import { createPinia } from 'pinia';
import { createRouter, createWebHistory } from 'vue-router';

// 创建测试路由器
export function createTestRouter(routes = []) {
  return createRouter({
    history: createWebHistory(),
    routes: [
      { path: '/', component: { template: '<div>Home</div>' } },
      ...routes
    ]
  });
}

// 创建完整的 Vue 应用挂载配置
export function createMountOptions(options = {}) {
  return {
    global: {
      plugins: [
        createPinia(),
        createTestRouter()
      ],
      stubs: {
        // 常用组件 stub
        'a-button': true,
        'a-input': true,
        'a-table': true,
        'das-table': true,
        'das-form': true
      },
      ...options.global
    },
    ...options
  };
}

// 等待 Vue 更新完成
export function waitForUpdate() {
  return new Promise(resolve => setTimeout(resolve, 0));
}

// 模拟用户输入
export async function setInputValue(wrapper: VueWrapper, selector: string, value: string) {
  const input = wrapper.find(selector);
  await input.setValue(value);
  await input.trigger('input');
  await waitForUpdate();
}

// 模拟表单提交
export async function submitForm(wrapper: VueWrapper, formSelector = 'form') {
  const form = wrapper.find(formSelector);
  await form.trigger('submit');
  await waitForUpdate();
}
```

