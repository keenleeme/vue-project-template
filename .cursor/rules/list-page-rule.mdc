```typescript
import { useButtonPermission } from '@/libs/hooks/useButtonPermission';

const pagePermission = useButtonPermission();
const hasPermission = (permissionId: string): boolean => {
  return pagePermission.value.some((item: any) => item.id === permissionId);
};
```

### 2. 按钮权限应用

```vue
<!-- 操作按钮 -->
<a-button v-if="hasPermission('ModuleNameAdd')" type="primary" @click="handleAdd">
