## 9. 性能优化

### 9.1 构建性能优化

```typescript
// vite.config.prod.ts
export default defineConfig({
  // 使用 esbuild 进行依赖预构建
  optimizeDeps: {
    include: [
      'vue',
      'vue-router',
      'pinia',
      'ant-design-vue',
      'lodash'
    ]
  },
  
  // 构建性能配置
  build: {
    // 使用多线程
    minify: 'esbuild',
    
    // 禁用 brotli 压缩（在 nginx 层处理）
    reportCompressedSize: false,
    
    // 减少输出
    rollupOptions: {
      output: {
        // 减少 chunk 数量
        manualChunks: (id) => {
          if (id.includes('node_modules')) {
            if (id.includes('vue')) return 'vue';
            if (id.includes('ant-design')) return 'antd';
            return 'vendor';
          }
        }
      }
    }
  }
});
```

