// ✅ Web Vitals 监控
import { getCLS, getFID, getFCP, getLCP, getTTFB } from 'web-vitals';

const performanceMonitor = () => {
  const metrics: Record<string, number> = {};
  
  // 监控核心指标
  getCLS(({ value }) => {
    metrics.CLS = value;
    console.log('CLS:', value);
  });
  
  getFID(({ value }) => {
    metrics.FID = value;
    console.log('FID:', value);
  });
  
  getFCP(({ value }) => {
    metrics.FCP = value;
    console.log('FCP:', value);
  });
  
  getLCP(({ value }) => {
    metrics.LCP = value;
    console.log('LCP:', value);
  });
  
  getTTFB(({ value }) => {
    metrics.TTFB = value;
    console.log('TTFB:', value);
  });
  
  // 发送监控数据
  const sendMetrics = () => {
    if (Object.keys(metrics).length > 0) {
      fetch('/api/performance-metrics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...metrics,
          timestamp: Date.now(),
          userAgent: navigator.userAgent,
          url: location.href
        })
      }).catch(console.error);
    }
  };
  
  // 页面卸载时发送数据
  addEventListener('beforeunload', sendMetrics);
  
  return { metrics, sendMetrics };
};

// ✅ 自定义性能监控
const customPerformanceMonitor = () => {
  const marks = new Map<string, number>();
  
  const mark = (name: string) => {
    marks.set(name, performance.now());
    performance.mark(name);
  };
  
  const measure = (name: string, startMark: string, endMark?: string) => {
    const endTime = endMark ? marks.get(endMark) : performance.now();
    const startTime = marks.get(startMark);
    
    if (startTime && endTime) {
      const duration = endTime - startTime;
      performance.measure(name, startMark, endMark);
      return duration;
    }
    
    return 0;
  };
  
  // API 请求性能监控
  const monitorAPICall = async <T>(
    name: string,
    apiCall: () => Promise<T>
  ): Promise<T> => {
    mark(`${name}-start`);
    
    try {
      const result = await apiCall();
      mark(`${name}-end`);
      
      const duration = measure(name, `${name}-start`, `${name}-end`);
      console.log(`API ${name} took ${duration}ms`);
      
      return result;
    } catch (error) {
      mark(`${name}-error`);
      measure(`${name}-error`, `${name}-start`, `${name}-error`);
      throw error;
    }
  };
  
  return { mark, measure, monitorAPICall };
};
```

### 4.2 长任务监控

```typescript
// ✅ 长任务检测
const longTaskMonitor = () => {
  if ('PerformanceObserver' in window) {
    const observer = new PerformanceObserver((list) => {
      list.getEntries().forEach((entry) => {
        console.warn('Long task detected:', {
          duration: entry.duration,
          startTime: entry.startTime,
          name: entry.name
        });
        
        // 发送长任务信息到监控服务
        if (entry.duration > 50) { // 超过 50ms 的任务
          sendLongTaskAlert({
            duration: entry.duration,
            startTime: entry.startTime,
            url: location.href
          });
        }
      });
    });
    
    observer.observe({ entryTypes: ['longtask'] });
    
    return () => observer.disconnect();
  }
  
  return () => {};
};

// ✅ 主线程阻塞检测
const mainThreadBlockingDetector = () => {
  let lastTime = performance.now();
  let blocked = false;
  
  const check = () => {
    const currentTime = performance.now();
    const gap = currentTime - lastTime;
    
    if (gap > 100) { // 主线程被阻塞超过 100ms
      console.warn('Main thread blocked for', gap, 'ms');
      blocked = true;
    } else {
      blocked = false;
    }
    
    lastTime = currentTime;
    requestAnimationFrame(check);
  };
  
  requestAnimationFrame(check);
  
  return () => blocked;
};
```

