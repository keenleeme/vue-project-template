    createValidationRules.required('请输入真实姓名'),
    createValidationRules.pattern(/^[\u4e00-\u9fa5]{2,10}$/, '请输入2-10位中文姓名')
  ],
  phone: phoneRules,
  email: emailRules,
  idCard: idCardRules,
  address: [
    createValidationRules.maxLength(200, '地址不能超过200个字符')
  ]
}
```

