## 3. 运行时性能优化

### 3.1 内存管理

```typescript
// ✅ 避免内存泄漏
const useCleanup = () => {
  const timers = new Set<number>();
  const listeners = new Map<EventTarget, Array<{
    event: string;
    handler: EventListener;
    options?: AddEventListenerOptions;
  }>>();
  
  // 定时器管理
  const setTimeout = (callback: () => void, delay: number) => {
    const timer = window.setTimeout(() => {
      callback();
      timers.delete(timer);
    }, delay);
    timers.add(timer);
    return timer;
  };
  
  // 事件监听器管理
  const addEventListener = (
    target: EventTarget,
    event: string,
    handler: EventListener,
    options?: AddEventListenerOptions
  ) => {
    target.addEventListener(event, handler, options);
    
    if (!listeners.has(target)) {
      listeners.set(target, []);
    }
    listeners.get(target)!.push({ event, handler, options });
  };
  
  // 清理函数
  const cleanup = () => {
    // 清理定时器
    timers.forEach(timer => clearTimeout(timer));
    timers.clear();
    
    // 清理事件监听器
    listeners.forEach((eventList, target) => {
      eventList.forEach(({ event, handler, options }) => {
        target.removeEventListener(event, handler, options);
      });
    });
    listeners.clear();
  };
  
  onUnmounted(cleanup);
  
  return { setTimeout, addEventListener, cleanup };
};

// ✅ 对象池模式
class ObjectPool<T> {
  private pool: T[] = [];
  private createFn: () => T;
  private resetFn: (obj: T) => void;
  
  constructor(createFn: () => T, resetFn: (obj: T) => void, initialSize = 5) {
    this.createFn = createFn;
    this.resetFn = resetFn;
    
    // 预填充对象池
    for (let i = 0; i < initialSize; i++) {
      this.pool.push(this.createFn());
    }
  }
  
  acquire(): T {
    return this.pool.pop() || this.createFn();
  }
  
  release(obj: T): void {
    this.resetFn(obj);
    this.pool.push(obj);
  }
}

// 使用示例：DOM 元素池
const divPool = new ObjectPool(
  () => document.createElement('div'),
  (div) => {
    div.innerHTML = '';
    div.className = '';
    div.style.cssText = '';
  }
);
```

### 3.2 渲染性能优化

```typescript
// ✅ 避免强制同步布局
const optimizeDOM = () => {
  // 批量 DOM 操作
  const batchDOMOperations = (operations: Array<() => void>) => {
    requestAnimationFrame(() => {
      operations.forEach(op => op());
    });
  };
  
  // 虚拟滚动实现
  const createVirtualScroll = (container: HTMLElement, itemHeight: number) => {
    const state = reactive({
      scrollTop: 0,
      containerHeight: 0,
      startIndex: 0,
      endIndex: 0,
      visibleItems: [] as any[]
    });
    
    const updateVisibleItems = (items: any[]) => {
      const startIndex = Math.floor(state.scrollTop / itemHeight);
      const endIndex = Math.min(
        startIndex + Math.ceil(state.containerHeight / itemHeight) + 1,
        items.length
      );
      
      state.startIndex = startIndex;
      state.endIndex = endIndex;
      state.visibleItems = items.slice(startIndex, endIndex);
    };
    
    const handleScroll = throttle((e: Event) => {
      state.scrollTop = (e.target as HTMLElement).scrollTop;
      updateVisibleItems(items);
    }, 16); // 60fps
    
    return { state, updateVisibleItems, handleScroll };
  };
  
  return { batchDOMOperations, createVirtualScroll };
};

// ✅ 使用 RAF 优化动画
const useAnimation = () => {
  const animate = (callback: (timestamp: number) => boolean) => {
    let animationId: number;
    
    const frame = (timestamp: number) => {
      const shouldContinue = callback(timestamp);
      if (shouldContinue) {
        animationId = requestAnimationFrame(frame);
      }
    };
    
    animationId = requestAnimationFrame(frame);
    
    return () => cancelAnimationFrame(animationId);
  };
  
  // 平滑滚动
  const smoothScrollTo = (element: HTMLElement, target: number, duration = 300) => {
    const start = element.scrollTop;
    const distance = target - start;
    const startTime = performance.now();
    
    return animate((timestamp) => {
      const elapsed = timestamp - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      // 缓动函数
      const easeInOutCubic = (t: number) => 
        t < 0.5 ? 4 * t * t * t : (t - 1) * (2 * t - 2) * (2 * t - 2) + 1;
      
      element.scrollTop = start + distance * easeInOutCubic(progress);
      
      return progress < 1;
    });
  };
  
  return { animate, smoothScrollTo };
};
```

### 3.3 网络性能优化

```typescript
// ✅ 资源预加载策略
const useResourcePreload = () => {
  // 预加载关键资源
  const preloadResource = (url: string, type: 'script' | 'style' | 'font' | 'image') => {
    const link = document.createElement('link');
    link.rel = 'preload';
    link.href = url;
    link.as = type;
    
    if (type === 'font') {
      link.crossOrigin = 'anonymous';
    }
    
    document.head.appendChild(link);
  };
  
  // DNS 预解析
  const preconnect = (domain: string) => {
    const link = document.createElement('link');
    link.rel = 'preconnect';
    link.href = domain;
    document.head.appendChild(link);
  };
  
  // 路由预加载
  const prefetchRoute = (routePath: string) => {
    const link = document.createElement('link');
    link.rel = 'prefetch';
    link.href = routePath;
    document.head.appendChild(link);
  };
  
  return { preloadResource, preconnect, prefetchRoute };
};

