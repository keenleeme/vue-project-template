## 主题响应式设计

### 1. 监听主题变化
```typescript
// 组件中监听主题变化
import { watch } from 'vue';
import { storeToRefs } from 'pinia';

const { themeConfig } = storeToRefs(useThemeStore());

watch(
  () => themeConfig.value.mode,
  (newMode) => {
    // 主题切换后的逻辑
    document.body.className = newMode === 'dark' ? 'theme-dark' : 'theme-light';
    
    // 更新图表主题
    updateChartTheme(newMode);
  },
  { immediate: true }
);
```

### 2. 图表主题适配
```typescript
// 图表主题切换
const updateChartTheme = (mode: string) => {
  const chartTheme = mode === 'dark' ? {
    backgroundColor: '#1c222e',
    textStyle: { color: '#fff' },
    grid: { borderColor: '#394052' }
  } : {
    backgroundColor: '#fff',
    textStyle: { color: '#1E2435' },
    grid: { borderColor: '#E9EAF0' }
  };
  
  // 应用到ECharts实例
  chartInstance.setOption(chartTheme);
};
```

## 主题持久化

### 1. 本地存储
```typescript
// Store中自动持久化
watch(themeConfig, (newValue) => {
  localStorage.setItem('ZQTHEMECONFIG', JSON.stringify(newValue));
}, { deep: true });

// 初始化时读取
const localThemeConfig = JSON.parse(
  localStorage.getItem('ZQTHEMECONFIG') || '{}'
);
```

### 2. 用户偏好同步
```typescript
// 登录后同步用户主题偏好
const syncUserTheme = async () => {
  try {
    const userConfig = await Http.get('/api/user/theme-config');
    themeStore.setThemeConfig(userConfig);
  } catch (error) {
    console.warn('获取用户主题配置失败:', error);
  }
};

// 保存用户主题偏好
const saveUserTheme = async (config: ThemeConfigType) => {
  try {
    await Http.post('/api/user/theme-config', config);
  } catch (error) {
    console.warn('保存用户主题配置失败:', error);
  }
};
```

## 系统适配

### 1. 系统主题检测
```typescript
// 检测系统主题偏好
const detectSystemTheme = () => {
  const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
  return mediaQuery.matches ? 'dark' : 'light';
};

// 监听系统主题变化
const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
mediaQuery.addEventListener('change', (e) => {
  if (themeConfig.value.followSystem) {
    themeStore.setThemeConfig({
      ...themeConfig.value,
      mode: e.matches ? 'dark' : 'light'
    });
  }
});
```

### 2. 多端适配
```less
// 移动端主题适配
@media (max-width: 768px) {
  .theme-light {
    --font-size-base: 14px;
  }
  
  .theme-dark {
    --color-bg-component: #1c222e;
  }
}
```

## 主题测试

### 1. 主题切换测试
```typescript
// 测试主题切换功能
describe('主题系统', () => {
  it('应该正确切换明暗主题', () => {
    const themeStore = useThemeStore();
    
    // 切换到暗黑主题
    themeStore.setThemeConfig({ mode: 'dark' });
    expect(themeStore.themeConfig.mode).toBe('dark');
    
    // 切换到明亮主题
    themeStore.setThemeConfig({ mode: 'light' });
    expect(themeStore.themeConfig.mode).toBe('light');
  });
  
  it('应该正确更新主题色', () => {
    const themeStore = useThemeStore();
    const newColor = '#ff6b6b';
    
    themeStore.setThemeConfig({ primaryColor: newColor });
    expect(themeStore.themeConfig.primaryColor).toBe(newColor);
  });
});
```

