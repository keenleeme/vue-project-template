        'node_modules/',
        'tests/',
        '**/*.d.ts',
        '**/*.config.*',
        'src/main.ts',
        'src/router/index.ts'
      ]
    }
  }
});
```

### 6.2 关键模块覆盖率要求

```typescript
// 不同模块的覆盖率要求
const coverageRequirements = {
