// src/utils/monitoring.ts
interface PerformanceMetrics {
  buildTime: string;
  version: string;
  environment: string;
}

function sendMetrics(metrics: PerformanceMetrics) {
  if (isProduction()) {
    // 发送指标到监控服务
    fetch('/api/metrics', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(metrics)
    }).catch(console.error);
  }
}

// 页面加载性能监控
function monitorPageLoad() {
  if (typeof window !== 'undefined' && 'performance' in window) {
    window.addEventListener('load', () => {
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming;
      
      const metrics = {
        loadTime: navigation.loadEventEnd - navigation.loadEventStart,
        domContentLoaded: navigation.domContentLoadedEventEnd - navigation.domContentLoadedEventStart,
        firstPaint: performance.getEntriesByName('first-paint')[0]?.startTime,
        firstContentfulPaint: performance.getEntriesByName('first-contentful-paint')[0]?.startTime
      };
      
      sendMetrics(metrics);
    });
  }
}

export { sendMetrics, monitorPageLoad };
```

## 8. 安全配置

### 8.1 构建时安全检查

```bash
#!/bin/bash
# scripts/security-check.sh

echo "🔒 开始安全检查..."

# 依赖漏洞检查
npm audit --audit-level moderate

# 检查敏感信息
echo "🔍 检查敏感信息泄露..."
grep -r --exclude-dir=node_modules --exclude-dir=.git \
  -E "(password|secret|key|token)" src/ || true

# 检查硬编码的 URL
echo "🔍 检查硬编码 URL..."
grep -r --exclude-dir=node_modules --exclude-dir=.git \
  -E "https?://[^/]+\.(com|cn|org)" src/ || true

echo "✅ 安全检查完成"
