### 1.3 数据处理优化

#### 大数据量处理

```typescript
// ✅ 使用分页加载大数据
const useInfiniteScroll = (loadMore: () => Promise<any[]>) => {
  const loading = ref(false);
  const hasMore = ref(true);
  
  const loadMoreData = async () => {
    if (loading.value || !hasMore.value) return;
    
    loading.value = true;
    try {
      const newData = await loadMore();
      if (newData.length === 0) {
        hasMore.value = false;
      }
    } finally {
      loading.value = false;
    }
  };
  
  return { loading, hasMore, loadMoreData };
};

// ✅ 数据预处理和缓存
const processTableData = useMemoize((rawData: any[]) => {
  return rawData.map(item => ({
    ...item,
    displayName: `${item.firstName} ${item.lastName}`,
    statusText: getStatusText(item.status),
    formattedDate: formatDate(item.createdAt)
  }));
});

// ✅ 使用 Web Workers 处理复杂计算
const calculateInWorker = (data: any[]) => {
  return new Promise((resolve) => {
    const worker = new Worker('/workers/calculation.js');
    worker.postMessage(data);
    worker.onmessage = (e) => {
      resolve(e.data);
      worker.terminate();
    };
  });
};
```

#### 网络请求优化

```typescript
// ✅ 请求缓存和去重
class RequestCache {
  private cache = new Map<string, Promise<any>>();
  private timeouts = new Map<string, number>();
  
  async get(url: string, options: RequestInit = {}, ttl = 300000) {
    const key = `${url}:${JSON.stringify(options)}`;
    
    // 检查缓存
    if (this.cache.has(key)) {
      return this.cache.get(key);
    }
    
    // 发起请求
    const promise = fetch(url, options).then(res => res.json());
    this.cache.set(key, promise);
    
    // 设置过期时间
    this.timeouts.set(key, setTimeout(() => {
      this.cache.delete(key);
      this.timeouts.delete(key);
    }, ttl));
    
    return promise;
  }
}

// ✅ 请求并发控制
class ConcurrencyController {
  private queue: Array<() => Promise<any>> = [];
  private running = 0;
  private maxConcurrency = 3;
  
  async add<T>(task: () => Promise<T>): Promise<T> {
    return new Promise((resolve, reject) => {
      this.queue.push(async () => {
        try {
          const result = await task();
          resolve(result);
        } catch (error) {
          reject(error);
        }
      });
      
      this.process();
    });
  }
  
  private async process() {
    if (this.running >= this.maxConcurrency || this.queue.length === 0) {
      return;
    }
    
    this.running++;
    const task = this.queue.shift()!;
    
    try {
      await task();
    } finally {
      this.running--;
      this.process();
    }
  }
}

// ✅ 预加载关键资源
const preloadCriticalResources = () => {
  const criticalAPIs = [
    '/api/user/profile',
    '/api/permissions',
    '/api/menu'
  ];
  
  // 并行预加载
  Promise.allSettled(
    criticalAPIs.map(url => requestCache.get(url))
  );
};
```

## 2. 构建性能优化

### 2.1 Vite 构建优化

```typescript
// vite.config.prod.ts
export default defineConfig({
  build: {
    // 使用 esbuild 进行压缩（比 terser 快）
    minify: 'esbuild',
    
    // 关闭构建报告（加快构建）
    reportCompressedSize: false,
    
    // 优化依赖预构建
    rollupOptions: {
      output: {
        // 智能分包
        manualChunks: (id) => {
          // 第三方库单独打包
          if (id.includes('node_modules')) {
            // Vue 生态
            if (id.includes('vue') || id.includes('pinia')) {
              return 'vue-vendor';
            }
            // UI 组件库
            if (id.includes('ant-design') || id.includes('das-component')) {
              return 'ui-vendor';
            }
            // 工具库
            if (id.includes('lodash') || id.includes('dayjs') || id.includes('echarts')) {
              return 'utils-vendor';
            }
            // 其他第三方库
            return 'vendor';
          }
          
          // 页面级分包
          if (id.includes('/views/')) {
            const module = id.split('/views/')[1].split('/')[0];
            return `page-${module}`;
          }
        }
      }
    }
  },
  
  // 优化依赖预构建
  optimizeDeps: {
    include: [
      'vue',
      'vue-router',
      'pinia',
      'ant-design-vue',
      'lodash',
      'dayjs'
    ],
    exclude: [
      // 排除大型库，按需加载
      'echarts'
    ]
  }
});
```

