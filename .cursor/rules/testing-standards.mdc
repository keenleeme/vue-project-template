### 7.3 异步测试处理

```typescript
// ✅ 正确的异步测试
describe('异步操作', () => {
  it('应该正确处理异步数据获取', async () => {
    const store = useDataStore();
    
    // 等待异步操作完成
    await store.fetchData();
    
    expect(store.loading).toBe(false);
    expect(store.data).toHaveLength(2);
  });

  it('应该处理异步错误', async () => {
    vi.mocked(api.getData).mockRejectedValue(new Error('网络错误'));
    
    const store = useDataStore();
    
    await store.fetchData();
    
    expect(store.error).toBe('网络错误');
    expect(store.loading).toBe(false);
  });
});
```

