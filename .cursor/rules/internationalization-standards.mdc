## 组件库国际化

### 1. DAS组件国际化
```vue
<template>
  <das-locale-provider :locale="dasLocale">
    <div id="app">
      <!-- DAS组件 -->
      <das-table />
      <das-form />
    </div>
  </das-locale-provider>
</template>

<script setup lang="ts">
import { computed } from 'vue';
import { useI18n } from 'vue-i18n';
import enUS from 'das-component-vue/es/locale/en';
import zhCN from 'das-component-vue/es/locale/zh-CN';

const { locale } = useI18n();

// 根据当前语言设置DAS组件语言
const dasLocale = computed(() => {
  return locale.value === 'en' ? enUS : zhCN;
});
</script>
```

### 2. Ant Design国际化
```vue
<template>
  <a-config-provider :locale="antdLocale">
    <!-- Ant Design组件 -->
  </a-config-provider>
</template>

<script setup lang="ts">
import { computed } from 'vue';
import { useI18n } from 'vue-i18n';
import zhCN from 'ant-design-vue/es/locale/zh_CN';
import enUS from 'ant-design-vue/es/locale/en_US';

const { locale } = useI18n();

const antdLocale = computed(() => {
  return locale.value === 'en' ? enUS : zhCN;
});
</script>
```

## 语言切换

### 1. 语言切换组件
```vue
<!-- LanguageSwitcher.vue -->
<template>
  <a-select 
    v-model:value="currentLocale"
    @change="handleLocaleChange"
  >
    <a-select-option value="zh">简体中文</a-select-option>
    <a-select-option value="en">English</a-select-option>
  </a-select>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue';
import { useI18n } from 'vue-i18n';
import { changeLocale } from '@international/vue3-i18n';

const { locale } = useI18n();
const currentLocale = ref(locale.value);

// 切换语言
const handleLocaleChange = (newLocale: string) => {
  changeLocale(newLocale);
  // 保存到本地存储
  localStorage.setItem('das-intl-locale', newLocale);
  // 可能需要刷新页面
  window.location.reload();
};

// 监听语言变化
watch(() => locale.value, (newLocale) => {
  currentLocale.value = newLocale;
});
</script>
```

### 2. 持久化语言设置
```typescript
// 在主题store或单独的语言store中管理
const handleLocaleChangeA = (key: string) => {
  // 更新i18n
  changeLocale(key);
  
  // 更新登录配置
  loginStore.set({ language: key });
  
  // 刷新页面确保所有组件更新
  window.location.reload();
};
```

## Kiwi工具使用

### 1. 命令行工具
```json
// package.json scripts
{
  "scripts": {
    "i18n:init": "das-intl --init",
    "i18n:extract": "das-intl --extract",
    "i18n:translate": "das-intl --translate",
    "i18n:exportAll": "das-intl --exportAll",
    "i18n:import": "das-intl --import ./export-en-US.csv en-US",
    "i18n:sync": "das-intl --sync"
  }
}
```

### 2. 工作流程
```bash
# 1. 初始化国际化
npm run i18n:init

# 2. 提取中文文本
npm run i18n:extract

# 3. 自动翻译
npm run i18n:translate

# 4. 导出翻译文件
npm run i18n:exportAll

# 5. 导入翻译
npm run i18n:import ./export-en-US.csv en-US

# 6. 同步翻译
npm run i18n:sync
```

### 3. 翻译提取
```typescript
// 代码中标记需要翻译的文本
const title = '用户管理'; // 会被自动提取

// 或使用注释标记
const dynamicText = getMessage(); // kiwi-disable-line
```

