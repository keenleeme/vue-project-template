    functions: 95,
    lines: 95
  },
  'src/store/': {
    statements: 90,  // Store 逻辑要求高覆盖率
    branches: 85,
    functions: 90,
    lines: 90
  },
  'src/composables/': {
    statements: 85,  // Composable 中等覆盖率
    branches: 80,
    functions: 85,
    lines: 85
  },
  'src/components/': {
    statements: 70,  // 组件覆盖率要求相对较低
    branches: 65,
    functions: 70,
    lines: 70
  }
};
