```

### 4. 分页自动跳转处理

当删除操作导致当前页数据为空且不是第一页时，自动跳转到上一页：

```typescript
const handleDelete = async (record: any) => {
  try {
    await deleteData(record.id);
    message.success('删除成功');
    
    // 检查是否需要跳转到上一页
    if (dataList.value.length === 1 && pagination.currentPage > 1) {
      pagination.currentPage -= 1;
    }
    
    // 重新加载数据
    await loadDataList();
  } catch (error) {
    message.error('删除失败');
  }
};
```

## 数据处理规范

### 1. 枚举值处理

#### 1.1 获取枚举值

共用枚举值通过 `getEnumOptions` 获取：

```typescript
import { getEnumOptions } from '@/api/common/getEnum';

// 单个枚举获取
const lifecycleStatusOptions = ref<any[]>([]);
const loadLifecycleStatusOptions = async () => {
  try {
    const res = await getEnumOptions('lifecycleStatus');
    if (res.code === 0) {
      lifecycleStatusOptions.value = res.data || [];
    }
  } catch (error) {
    console.error('获取生命周期状态枚举失败:', error);
  }
};

// 多个枚举获取 - 封装成函数
const fetchEnumOptions = async () => {
  try {
    const [statusRes, typeRes, levelRes] = await Promise.all([
      getEnumOptions('status'),
      getEnumOptions('type'),
      getEnumOptions('level')
    ]);
    
    if (statusRes.code === 0) statusOptions.value = statusRes.data || [];
    if (typeRes.code === 0) typeOptions.value = typeRes.data || [];
    if (levelRes.code === 0) levelOptions.value = levelRes.data || [];
  } catch (error) {
    console.error('获取枚举值失败:', error);
  }
};
```

