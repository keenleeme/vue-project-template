## 4. 图表组件使用规范

### 4.1 使用 CommonEChart 组件

```vue
<template>
  <!-- 饼图 -->
  <CommonEChart :option="pieChartOption" height="300px" />
  
  <!-- 柱状图 -->
  <CommonEChart :option="barChartOption" height="400px" />
  
  <!-- 折线图 -->
  <CommonEChart :option="lineChartOption" height="350px" />
</template>

<script setup lang="ts">
import { ref, computed } from 'vue';

// 饼图配置（处理超长文本）
const pieChartOption = computed(() => ({
  tooltip: {
    trigger: 'item',
    formatter: (params: any) => {
      // 显示完整文本
      const originalName = params.data.originalName || params.name;
      return `${params.seriesName}<br/>${originalName}: ${params.value} (${params.percent}%)`;
    }
  },
  legend: {
    orient: 'horizontal',
    bottom: 0,
    left: 'center',
    itemWidth: 12,
    itemHeight: 8,
    textStyle: {
      fontSize: 12,
      overflow: 'truncate',
      ellipsis: '...',
      width: 100
    }
  },
  series: [{
    name: '统计数据',
    type: 'pie',
    radius: ['45%', '75%'],
    center: ['50%', '45%'],
    data: chartData.value.map(item => ({
      name: item.name.length > 8 ? item.name.substring(0, 8) + '...' : item.name,
      value: item.value,
      originalName: item.name // 保存原始名称
    }))
  }]
}));

// 柱状图配置（处理X轴标签）
const barChartOption = computed(() => ({
  tooltip: {
    trigger: 'axis',
    axisPointer: { type: 'shadow' }
  },
  xAxis: {
    type: 'category',
    data: chartData.value.map(item => item.name),
    axisLabel: {
      interval: 0,
      rotate: 45, // 旋转标签
      formatter: (value: string) => {
        return value.length > 6 ? value.substring(0, 6) + '...' : value;
      }
    }
  },
  yAxis: { type: 'value' },
  series: [{
    type: 'bar',
    data: chartData.value.map(item => item.value),
    itemStyle: {
      borderRadius: [4, 4, 0, 0]
    }
  }]
}));
</script>
```

