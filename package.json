{
  "name": "vue3-ts-vite-project",
  "version": "1.0.0",
  "description": "智启vue3开发模板",
  "author": "",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm-run-all --parallel dev:frontend dev:mock",
    "dev:frontend": "cross-env NODE_ENV=development vite --config ./configs/vite.config.dev.ts",
    "dev:mock": "node mock-server.js",
    "mock": "node mock-server.js",
    "build": "cross-env NODE_ENV=production  vite build --config ./configs/vite.config.prod.ts && npm run build:micro",
    "lint": "npx lint-staged",
    "lint-fix": "eslint --fix --ext .js --ext .jsx  --ext .tsx --ext .ts  --ext .vue src/",
    "prepare": "husky install",
    "i18n:init": "das-intl --init",
    "i18n:extract": "das-intl --extract",
    "i18n:translate": "das-intl --translate",
    "i18n:exportAll": "das-intl --exportAll",
    "i18n:import": "das-intl --import ./export-en-US.csv en-US",
    "i18n:sync": "das-intl --sync",
    "bootstrap": "yarn && npm-run-all --serial install:*",
    "start:micro": "npm-run-all --parallel start-child:*",
    "build:micro": "npm-run-all --parallel build-child:* && cd src/micro/example/child-react && npm run build",
    "install:child-react": "cd src/micro/example/child-react && npm install",
    "install:child-vue2": "cd src/micro/example/vue2 && pnpm install",
    "install:child-vue3": "cd src/micro/example/vue3 && pnpm install",
    "install:child-angular": "cd src/micro/example/angular && yarn",
    "start-child:vue2": "cd src/micro/example/vue2 && pnpm run serve",
    "start-child:vue3": "cd src/micro/example/vue3 && pnpm run dev",
    "start-child:react": "cd src/micro/example/child-react && npm start",
    "start-child:angular": "cd src/micro/example/angular && yarn start",
    "build-child:vue2": "cd src/micro/example/vue2 && npm run build",
    "build-child:vue3": "cd src/micro/example/vue3 && npm run build",
    "build-child:angular": "cd src/micro/example/angular && npm run build",
    "build:lib": "vite build --config ./configs/vite.config.lib.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@international/vue3-i18n": "^1.2.0",
    "@micro-zoe/micro-app": "^1.0.0-rc.13",
    "@types/color": "^4.2.0",
    "@ued-material/menu": "^2.2.23",
    "@ued-material/ued-wbc-vue3": "^0.2.7",
    "@ued-material/vue-tour": "^1.2.2",
    "@vue/server-renderer": "^3.5.13",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.5.1",
    "codemirror": "^5.65.20",
    "color": "^4.2.3",
    "core-js": "^3.45.1",
    "das-component-vue": "^1.2.13-beta.2",
    "dayjs": "^1.11.13",
    "docs-viewer": "^0.0.5",
    "echarts": "^5.5.1",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.0",
    "npm-run-all": "^4.1.5",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "pinyin-engine": "^1.2.2",
    "ued-login": "^1.1.11",
    "vite-plugin-eslint": "^1.8.1",
    "vue": "^3.4.15",
    "vue-echarts": "^7.0.3",
    "vue-live": "^2.5.4",
    "vue-router": "^4.2.5",
    "vue3-tour": "^1.0.3",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.0",
    "@commitlint/config-angular": "^17.8.0",
    "@international/cli": "^1.2.0",
    "@originjs/vite-plugin-federation": "^1.3.6",
    "@trivago/prettier-plugin-sort-imports": "^4.2.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.9.0",
    "@unocss/postcss": "^0.57.1",
    "@unocss/preset-rem-to-px": "^0.57.1",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/compiler-sfc": "^3.3.8",
    "autoprefixer": "^10.4.16",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.2",
    "eslint": "^8.0.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "express": "^5.1.0",
    "husky": "^8.0.3",
    "less": "^4.2.0",
    "lint-staged": "^14",
    "mini-svg-data-uri": "^1.4.4",
    "prettier": "^3.0.3",
    "sharp": "^0.33.5",
    "svgo": "^3.3.2",
    "typescript": "5.3.3",
    "unocss": "^0.57.7",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^4.5.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^1.1.8",
    "vite-plugin-vue-devtools": "^7.0.16",
    "vue-eslint-parser": "^9.3.2",
    "vue-tsc": "^1.8.22"
  },
  "resolutions": {
    "strip-ansi": "6.0.0",
    "cheerio": "1.0.0-rc.12"
  },
  "license": "MIT"
}
